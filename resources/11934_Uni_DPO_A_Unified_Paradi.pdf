/S/Span<</ActualText(\040\040\\begin\040{aligned}\040&\040\\nabla\040_{\\theta\040}\040\\mathcal\040{L}_{\\text\040{Uni-DPO}}\040\\\\\040&\040=\040-\\mathbb\040{E}_{\(x,\040y_{w},\040y_{l}\)\\sim\040D}\\Bigl\040[\040w_{\\text\040{qual}}\040\(1-\\sigma\040\(\\Delta\040_{\\text\040{adj}}\)\)^{\\gamma\040}\\Bigl\040\(\(1-\\sigma\040\(\\Delta\040_{r}\)\)-\\gamma\040\\sigma\040\(\\Delta\040_{\\text\040{adj}}\)\\log\040\\sigma\040\(\\Delta\040_{r}\)\\Bigr\040\)\\nabla\040_{\\theta\040}\\Delta\040_{r}\040\\\\\040&\040\\phantom\040{=}+\\lambda\040\\!\\cdot\040\\!\\mathbf\040{1}\\bigl\040\(\\log\040\\pi\040_{\\text\040{ref}}\(y_{w}\040\\mid\040x\)>\\log\040\\pi\040_{\\theta\040}\(y_{w}\040\\mid\040x\)\\bigr\040\)\\mathbf\040{1}\\bigl\040\(S_{w}\\ge\040\\tau\040_{\\text\040{good}}\\bigr\040\)\\cdot\040\\nabla\040_{\\theta\040}\\frac\040{\\log\040\\pi\040_{\\theta\040}\(y_{w}\040\\mid\040x\)}{\\lvert\040y_{w}\\rvert\040}\\Bigr\040]\040\\\\\040&\040=\040-\\mathbb\040{E}\\biggl\040\\{\\Bigl\040[\\beta\040{w}_{\\text\040{qual}}\040\(1\\!-\\!\\sigma\040\(\\Delta\040_{\\text\040{adj}}\)\)^{\\gamma\040}\040\\Bigl\040\(\(1\\!-\\!\\sigma\040\(\\Delta\040_{r}\)\)\\!-\\!\\gamma\040\\sigma\040\(\\Delta\040_{\\text\040{adj}}\)\\log\040\\sigma\040\(\\Delta\040_{r}\)\\Bigr\040\)\040\\!+\\!\\lambda\040\\!\\cdot\040\\!{I}\\Bigr\040]\040\\nabla\040_{\\theta\040}\\frac\040{\\log\040\\pi\040_{\\theta\040}\(y_{w}\\!\\mid\040\\!\040x\)}{|y_{w}|}\040\\\\\040&\040\\phantom\040{=-\\mathbb\040{E}\\biggl\040\\{}\040+\040\\Bigl\040[\\beta\040w_{\\text\040{qual}}\040\(1\\!-\\!\\sigma\040\(\\Delta\040_{\\text\040{adj}}\)\)^{\\gamma\040}\040\\Bigl\040\(\(1\\!-\\!\\sigma\040\(\\Delta\040_{r}\)\)\040\\!-\\!\\gamma\040\\sigma\040\(\\Delta\040_{\\text\040{adj}}\)\\log\040\\sigma\040\(\\Delta\040_{r}\)\040\\Bigr\040\)\040\\Bigr\040]\\nabla\040_{\\theta\040}\\frac\040{\\log\040\\pi\040_{\\theta\040}\(y_{l}\\!\\mid\040\\!\040x\)}{|y_{l}|}\\biggr\040\\}.\040\\end\040{aligned}\040\\label\040{eq:uni_dpo_gradient}\04